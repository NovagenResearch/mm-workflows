// NOTE: This file should be in one of the directories listed in search_paths_wic
// (Technically comments are not allowed in JSON, but we are manually
// stripping out all lines that start with // before parsing.)
{
    // Due to the computational complexity of the graph isomorphism problem, we
    // need to manually exclude large workflows.
    // See https://en.wikipedia.org/wiki/Graph_isomorphism_problem
    "large_workflows": [
        "elm", "vs_demo_2", "vs_demo_3", "vs_demo_4",
        "vs_demo_2_weekly",
        "vs_demo_3_weekly",
        "vs_demo_4_weekly",
        "docking_rescoring_weekly"
    ],
    // Library workflows: each needs an input or an edge (!*) that only a parent workflow
    // supplies, so none of them runs on its own. The cwl_subinterpreter_* workflows compile
    // to no steps: they watch the files a parent's MD run writes.
    "fragments": [
        "assign_partial_charges_batch",
        "convert_ligand_mol2_to_pdbqt_mdanalysis",
        "download_smiles_ligand_db",
        "convert_ligand_mol2_to_pdbqt_obabel",
        "analysis_realtime_ligand",
        "analysis_realtime_complex",
        "analysis_realtime_protein",
        "ligand_modeling_docking",
        "align_protein_CA_pymol",
        "assign_partial_charges",
        "minimize_ligand_only",
        "analysis_final_steps",
        "autodock_vina_rescore",
        "analysis_final",
        "gen_topol_params",
        "analysis_realtime",
        "convert_pdbqt",
        "download_pdb",
        "setup_vac_min",
        "npt_gromacs",
        "setup_pdb",
        "docking_stability",
        "npt_amber",
        "analysis",
        "solv_ion",
        "topology",
        "stability",
        "docking",
        "l-bfgs",
        "basic",
        "equil",
        "setup",
        "steep",
        "prod",
        "flc",
        "npt",
        "nvt",
        "min",
        "cg",
        "yank",
        "cwl_subinterpreter_analysis",
        "cwl_subinterpreter_complex",
        "cwl_subinterpreter_ligand",
        "cwl_subinterpreter_protein"
    ],
    // Run Workflows skips these on every push; Run Workflows Weekly runs all of them.
    "intensive": [
        // The *_weekly workflows scatter over more inputs than the workflows they are named after.
        "vs_demo_2_weekly",
        "vs_demo_3_weekly",
        "vs_demo_4_weekly",
        "docking_rescoring_weekly",
        "run_diffdock_weekly",
        // vs_demo_4 and run_diffdock are the only step of their *_weekly workflows, which take
        // about 40 and 12 minutes; nmr runs tutorial's MD again before its analysis.
        "vs_demo_4",
        "run_diffdock",
        "nmr"
    ]
}
